server:
  port: 8080

spring:
  application:
    name: spider-media

  # 激活的配置文件，可通过环境变量 SPRING_PROFILES_ACTIVE=prod 切换到生产模式
  profiles:
    active: ${SPRING_PROFILES_ACTIVE:dev}

  datasource:
    type: com.alibaba.druid.pool.DruidDataSource
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 数据库连接地址，通过环境变量 DB_HOST/DB_PORT/DB_NAME 覆盖默认值
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:spider_media}?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    # 数据库账号 —— 必须显式配置环境变量 DB_USERNAME，未配置时启动失败（避免误用 root）
    username: ${DB_USERNAME}
    # 数据库密码 —— 必须显式配置环境变量 DB_PASSWORD，未配置时启动失败（避免默认弱密码）
    password: ${DB_PASSWORD}
    druid:
      initial-size: 5
      min-idle: 5
      max-active: 20
      max-wait: 60000
      time-between-eviction-runs-millis: 60000
      min-evictable-idle-time-millis: 300000
      validation-query: SELECT 1
      test-while-idle: true
      test-on-borrow: false
      test-on-return: false
      # Druid 监控页面（/druid/**）默认不开放，需要时配置 StatViewServlet
      stat-view-servlet:
        enabled: false
      web-stat-filter:
        enabled: false

  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      database: ${REDIS_DB:0}
      password: ${REDIS_PASSWORD:}

  quartz:
    job-store-type: jdbc
    jdbc:
      initialize-schema: always

  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB

  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai

mybatis:
  mapper-locations: classpath*:mapper/**/*.xml
  configuration:
    map-underscore-to-camel-case: true
    # 使用 SLF4J 输出 SQL 日志（走 logback 配置），生产环境可关闭 debug 级别即可停止 SQL 输出
    # 比 StdOutImpl 更可控，避免直接 System.out.println 影响性能与日志归档
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl

pagehelper:
  helperDialect: mysql
  reasonable: true
  supportMethodsArguments: true
  params: count=countSql

# Token 配置
token:
  # JWT 签名密钥 —— 必须显式配置环境变量 JWT_SECRET（至少 32 字符），未配置时启动失败
  # 切勿在此处填写默认值，避免生产环境误用弱密钥导致 token 可被伪造
  secret: ${JWT_SECRET}
  # Token 过期时间（毫秒），默认 24 小时
  expireTime: ${TOKEN_EXPIRE_TIME:86400000}

# AI 模型配置（API 密钥建议在管理后台 → 模型管理中在线维护，此处仅作为 fallback）
ai:
  models:
    zhipu:
      api-key: ${ZHIPU_API_KEY:}
      base-url: https://open.bigmodel.cn/api/paas/v4
    deepseek:
      api-key: ${DEEPSEEK_API_KEY:}
      base-url: https://api.deepseek.com
    qwen:
      api-key: ${QWEN_API_KEY:}
      base-url: https://dashscope.aliyuncs.com/compatible-mode/v1

# 跨域配置（CORS）—— 用于 SecurityConfig 加载允许的源
cors:
  # 允许的来源，多个用逗号分隔。生产环境建议显式列出前端域名，避免使用 "*"（不会携带 Cookie）
  allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:3000}
  allowed-methods: GET,POST,PUT,DELETE,OPTIONS
  allowed-headers: "*"
  allow-credentials: true
  max-age: 3600

# Spring Boot Actuator 配置（健康检查、指标监控）
management:
  endpoints:
    web:
      exposure:
        # 暴露的端点：健康检查、信息、指标、运行时环境
        # prod 环境建议仅暴露 health 和 info，通过 profile 覆盖
        include: ${ACTUATOR_ENDPOINTS:health,info,metrics,env}
  endpoint:
    health:
      show-details: when-authorized
  info:
    env:
      enabled: true

# SpringDoc OpenAPI 3 配置（接口文档，访问 /swagger-ui.html）
springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
    # 启用功能开关，prod 环境通过 profile 关闭
    enabled: ${SPRINGDOC_ENABLED:true}

# Resilience4j 配置（熔断、限流、重试）
resilience4j:
  circuitbreaker:
    configs:
      default:
        # 失败率阈值（百分比），达到后触发熔断
        failure-rate-threshold: 50
        # 慢调用阈值（秒），超过视为慢调用
        slow-call-duration-threshold: 10s
        # 慢调用率阈值（百分比），达到后触发熔断
        slow-call-rate-threshold: 60
        # 半开状态允许的请求数
        permitted-number-of-calls-in-half-open-state: 3
        # 滑动窗口大小（请求数）
        sliding-window-size: 10
        # 滑动窗口类型：基于请求数
        sliding-window-type: COUNT_BASED
        # 熔断器打开后等待时间（秒），之后进入半开状态
        wait-duration-in-open-state: 30s
    instances:
      # AI 服务熔断器（AI API 可能不稳定，需熔断保护）
      ai-service:
        base-config: default
      # 爬虫服务熔断器
      crawler-service:
        base-config: default
  retry:
    configs:
      default:
        # 最大重试次数（不含首次调用）
        max-attempts: 3
        # 重试间隔（毫秒）
        wait-duration: 1s
    instances:
      ai-service:
        base-config: default
      crawler-service:
        base-config: default
  ratelimiter:
    configs:
      default:
        # 每个周期内允许的请求数
        limit-for-period: 10
        # 限流周期（毫秒）
        limit-refresh-period: 1s
        # 等待可用令牌的超时时间（毫秒）
        timeout-duration: 0
    instances:
      # 登录接口限流（防爆破）
      login-endpoint:
        base-config: default

logging:
  level:
    # 默认 info 级别；开发环境可通过 -Dlogging.level.com.spider.media=debug 或 profile 覆盖
    com.spider.media: info
    org.springframework.security: info
    # MyBatis SQL 日志：dev 环境 debug，prod 环境 warn
    com.spider.media.system.mapper: warn
    com.spider.media.datacollection.mapper: warn
    com.spider.media.aicreation.mapper: warn
    com.spider.media.contentpublish.mapper: warn
    com.spider.media.taskscheduler.mapper: warn
