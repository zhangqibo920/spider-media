<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.spider</groupId>
        <artifactId>spider-media</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>spider-admin</artifactId>
    <packaging>jar</packaging>

    <name>spider-admin</name>
    <description>启动模块 - SpringBoot应用入口</description>

    <dependencies>
        <!-- 依赖框架模块 -->
        <dependency>
            <groupId>com.spider</groupId>
            <artifactId>spider-framework</artifactId>
        </dependency>
        <!-- 依赖系统模块 -->
        <dependency>
            <groupId>com.spider</groupId>
            <artifactId>spider-system</artifactId>
        </dependency>
        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <!-- 依赖所有业务模块 -->
        <dependency>
            <groupId>com.spider</groupId>
            <artifactId>spider-datacollection</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spider</groupId>
            <artifactId>spider-aicreation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spider</groupId>
            <artifactId>spider-contentpublish</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spider</groupId>
            <artifactId>spider-taskscheduler</artifactId>
        </dependency>

        <!-- Spring Boot Actuator（健康检查、指标监控、运行时管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Resilience4j（熔断、限流、重试、舱壁隔离，替代 Hystrix） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
